{
  "autoCompactThreshold": 0.5,
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/sync-agent.sh precompact"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/sync-agent.sh sessionend"
          }
        ]
      }
    ]
  }
}
